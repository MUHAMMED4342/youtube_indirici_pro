; Script generated by the Inno Setup Script Wizard, ONEDIR (çok dosyalı)
; PyInstaller çıktısına göre düzeltildi.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only
#define MyAppName "youtube_indirici_pro"
#define MyAppVersion "2.0"
#define MyAppPublisher "bilgisayar netlify app, Inc."
#define MyAppURL "http://bilgisayar.netlify.app/"
#define MyAppExeName "YouTubeIndiriciPro.exe"
; PyInstaller'ın onedir çıktısının bulunduğu klasör. Bu .iss dosyası,
; youtube_indirici_pro.py / .spec ile AYNI KLASÖRE konulacağı için yol
; SourcePath (bu .iss dosyasının bulunduğu klasör) baz alınarak GÖRELİ
; (relative) olarak hesaplanır — hangi bilgisayarda / hangi klasörde
; olursa olsun elle değiştirmenize gerek kalmaz. "pyinstaller
; youtube_indirici_pro.spec" komutu bu klasörün içinde çalıştırıldığında
; PyInstaller çıktıyı otomatik olarak "dist\YouTubeIndiriciPro" altına
; koyar; aşağıdaki tanım tam olarak o klasörü gösterir.
#define MyAppDistDir SourcePath + "dist\YouTubeIndiriciPro"
#define MyAppAssocName MyAppName + " File"
#define MyAppAssocExt ".myp"
#define MyAppAssocKey StringChange(MyAppAssocName, " ", "") + MyAppAssocExt

#if !DirExists(MyAppDistDir)
  #error "dist\YouTubeIndiriciPro klasoru bulunamadi. Once bu .iss ile ayni klasorde 'pyinstaller youtube_indirici_pro.spec' komutunu calistirin, sonra bu .iss dosyasini derleyin."
#endif

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{05D39AF4-1D10-4538-B5C6-246116DB6DD3}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
; "ArchitecturesAllowed=x64compatible" specifies that Setup cannot run
; on anything but x64 and Windows 11 on Arm.
ArchitecturesAllowed=x64compatible
; "ArchitecturesInstallIn64BitMode=x64compatible" requests that the
; install be done in "64-bit mode" on x64 or Windows 11 on Arm,
; meaning it should use the native 64-bit Program Files directory and
; the 64-bit view of the registry.
ArchitecturesInstallIn64BitMode=x64compatible
ChangesAssociations=yes
DisableProgramGroupPage=yes
; Remove the following line to run in administrative install mode (install for all users).
PrivilegesRequired=lowest
OutputDir=youtube_indirici_pro.setup
; Onemli: GitHub Releases'e yuklerken web siten
; ".../releases/latest/download/youtube_indirici_pro.setup.exe" adresini
; kontrol ettigi icin cikti dosyasinin adi TAM OLARAK bu isimle eslesmeli.
; Inno Setup ".exe" uzantisini kendisi ekledigi icin buraya sadece
; "youtube_indirici_pro.setup" yaziyoruz -> sonuc: youtube_indirici_pro.setup.exe
OutputBaseFilename=youtube_indirici_pro.setup
SolidCompression=yes
WizardStyle=modern
; Onedir yapı çok sayıda dosya (DLL'ler, wx kütüphaneleri vb.) içerir;
; kurulumdan önce eski bir sürümden kalan artık dosyaların birikmemesi
; için uygulama klasörünü kaldırmadan önce temizlemek iyi bir pratiktir
; (bkz. [UninstallDelete] ve aşağıdaki [Code] bölümü).

[Languages]
Name: "turkish"; MessagesFile: "compiler:Languages\Turkish.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; ONEDIR DÜZELTMESİ: Tek bir .exe yerine PyInstaller'ın dist\YouTubeIndiriciPro\
; klasöründeki TÜM içerik (exe + tüm DLL/PYD/veri dosyaları) alt klasörler
; dahil olacak şekilde kopyalanır. "{#MyAppExeName}" tek başına artık
; ÇALIŞMAZ çünkü onedir modunda exe, yanındaki DLL'lere muhtaçtır.
Source: "{#MyAppDistDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Registry]
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocExt}\OpenWithProgids"; ValueType: string; ValueName: "{#MyAppAssocKey}"; ValueData: ""; Flags: uninsdeletevalue
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}"; ValueType: string; ValueName: ""; ValueData: "{#MyAppAssocName}"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[UninstallDelete]
; Onedir klasöründeki tüm dosya/alt klasörlerin kaldırma sırasında
; temizlendiğinden emin olur (kullanıcı verileri APPDATA'da olduğu için
; buraya dahil değildir; yalnızca program dosyaları silinir).
Type: filesandordirs; Name: "{app}"
